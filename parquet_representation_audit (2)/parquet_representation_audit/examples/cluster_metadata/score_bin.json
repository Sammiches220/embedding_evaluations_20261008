{
  "schema_version": 1,
  "name": "score_bin",
  "family": "numeric_bin",
  "source_fields": ["score"],
  "description": "Interpretable bins for score.",
  "reasoning": "Separate negative and zero scores, then use progressively wider positive bands so high-score tails remain visible without excessive fragmentation.",
  "fallback_label": 0,
  "excluded_from_coverage": [0],
  "labels": [
    {"id": 0, "name": "missing", "criteria": "value is NULL"},
    {"id": 1, "name": "<= -1", "criteria": "value <= -1"},
    {"id": 2, "name": "(-1, 0]", "criteria": "-1 < value <= 0"},
    {"id": 3, "name": "(0, 5]", "criteria": "0 < value <= 5"},
    {"id": 4, "name": "(5, 10]", "criteria": "5 < value <= 10"},
    {"id": 5, "name": "(10, 25]", "criteria": "10 < value <= 25"},
    {"id": 6, "name": "(25, 50]", "criteria": "25 < value <= 50"},
    {"id": 7, "name": "(50, 100]", "criteria": "50 < value <= 100"},
    {"id": 8, "name": "(100, 250]", "criteria": "100 < value <= 250"},
    {"id": 9, "name": "(250, 500]", "criteria": "250 < value <= 500"},
    {"id": 10, "name": "> 500", "criteria": "value > 500"}
  ],
  "cuts": [-1, 0, 5, 10, 25, 50, 100, 250, 500],
  "bin_strategy": "fixed_interpretable"
}
