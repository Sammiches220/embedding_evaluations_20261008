{
  "schema_version": 1,
  "status": "validated",
  "dataset": {
    "name": "Synthetic instrument readings",
    "path": "readings.parquet",
    "unmapped_columns": "error"
  },
  "columns": {
    "reading_ref": {
      "role": "id",
      "id_type": "string",
      "canonicalization": "lossless_string"
    },
    "condition": {
      "role": "feature",
      "kind": "categorical",
      "id_type": "string"
    },
    "pulse_count": {
      "role": "feature",
      "kind": "count",
      "units": "pulses"
    },
    "temperature": {
      "role": "feature",
      "kind": "numeric",
      "units": "degrees C",
      "invalid_values": "unknown"
    },
    "alarms": {
      "role": "feature",
      "kind": "multilabel",
      "encoding": "delimited",
      "delimiter": "|",
      "case": "preserve",
      "empty_is_unknown": false,
      "min_count": 2,
      "max_labels": 6
    },
    "calibration_ok": {
      "role": "feature",
      "kind": "boolean"
    },
    "station_id": {
      "role": "group"
    },
    "engineer_note": {
      "role": "feature",
      "kind": "text"
    }
  },
  "embeddings": [
    {
      "name": "Instrument A",
      "matrix_path": "encoder_a.npy",
      "ids_path": "encoder_a_ids.npy",
      "expected_dimension": 6,
      "main_normalization": "none"
    },
    {
      "name": "Instrument B",
      "matrix_path": "encoder_b.npy",
      "ids_path": "encoder_b_ids.npy",
      "expected_dimension": 10,
      "main_normalization": "none"
    }
  ]
}
