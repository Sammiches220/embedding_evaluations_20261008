        "max_dense_feature_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_external_ids": {
          "type": "integer",
          "minimum": 1
        },
        "external_batch_rows": {
          "type": "integer",
          "minimum": 1
        },
        "max_source_batch_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_source_batch_cells": {
          "type": "integer",
          "minimum": 1
        },
        "max_work_units": {
          "type": "integer",
          "minimum": 1
