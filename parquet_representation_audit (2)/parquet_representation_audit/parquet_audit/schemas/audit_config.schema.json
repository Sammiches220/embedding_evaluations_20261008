    "missingness": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "features": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "fractions": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          }
        },
        "modes": {
          "type": "array",
          "items": {
            "enum": [
