          "type": "object",
          "properties": {
            "raw_euclidean": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "unit_chordal": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "additionalProperties": false
