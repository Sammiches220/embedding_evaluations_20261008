      "properties": {
        "scope": {
          "enum": [
            "full",
            "evaluation"
          ]
        },
        "batch_rows": {
          "type": "integer",
          "minimum": 1
        },
        "max_vocabulary": {
          "type": "integer",
          "minimum": 1
        },
        "quantile_sample_size": {
          "type": "integer",
          "minimum": 1
        },
        "max_feature_columns": {
          "type": "integer",
          "minimum": 1
